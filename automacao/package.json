{
  "name": "ecac-pendencias",
  "version": "1.0.0",
  "private": true,
  "description": "Robo local que acessa o e-CAC com certificado do procurador, troca de empresa e baixa o Relatorio de Situacao Fiscal (pendencias) de cada CNPJ.",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "empresa": "node src/index.js --cnpj",
    "instalar-navegador": "playwright install chromium",
    "mapear": "node src/mapear.js",
    "planilha": "node src/planilha.js",
    "painel": "node src/painel.js"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "playwright": "^1.49.0"
  },
  "engines": {
    "node": ">=18"
  }
}
